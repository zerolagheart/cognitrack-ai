# Copy to .env and adjust. Never commit .env.
COGNITRACK_ENVIRONMENT=development
COGNITRACK_LOG_LEVEL=INFO

# Local (no Docker): SQLite file is used when unset.
# COGNITRACK_DATABASE_URL=postgresql+psycopg://cognitrack:change-me-local-only@localhost:5432/cognitrack

# API keys (comma-separated per role). Leave all empty for an auth-disabled development setup.
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COGNITRACK_VIEWER_API_KEYS=
COGNITRACK_RESEARCHER_API_KEYS=
COGNITRACK_ADMIN_API_KEYS=

COGNITRACK_MAX_UPLOAD_MB=25
COGNITRACK_RETAIN_RAW_AUDIO=false
COGNITRACK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Docker Compose PostgreSQL credentials (local only).
POSTGRES_USER=cognitrack
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cognitrack

# Frontend: key the dashboard sends (only if auth is enabled). Baked into the static build; use a viewer/researcher key.
VITE_API_KEY=

# Optional: alternate pipeline config merged over configs/default.yaml
# COGNITRACK_CONFIG=configs/my_experiment.yaml
